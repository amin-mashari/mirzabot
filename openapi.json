{
  "openapi": "3.1.0",
  "info": {
    "title": "TonPays API",
    "description": "REST API for TonPays payment invoices.\n\n**Authentication:** click **Authorize**, paste your API key (only the key value), then **Authorize** again.\nGet the key from the Telegram bot menu: `مستندات API`.\n\n**Callback URL:** optional `callback_url` when creating an invoice. TonPays POSTs a simple JSON body to that URL when the payment is approved, rejected, or expired.\n\nSample payload:\n\n```json\n{\n  \"invoice_id\": \"TP-ABC123XYZ0\",\n  \"order_id\": \"12345\",\n  \"request_amount\": 50000,\n  \"final_amount\": 50037,\n  \"status\": \"completed\",\n  \"paid\": true\n}\n```\n\nHeader: `X-API-Key` (your merchant API key). If `paid` is `true`, confirm the order.\n\nIf you see `INVALID_API_KEY`, the key is not in the database — copy a fresh key from the bot (especially after rotating it).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/invoices/create": {
      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Create invoice",
        "operationId": "create_invoice_api_v1_invoices_create_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvoiceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateInvoiceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/api/v1/invoices/check/{invoice_id}": {
      "get": {
        "tags": [
          "invoices"
        ],
        "summary": "Check invoice status (GET)",
        "operationId": "check_invoice_by_id_api_v1_invoices_check__invoice_id__get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "invoice_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Invoice Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckInvoiceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/invoices/check": {
      "post": {
        "tags": [
          "invoices"
        ],
        "summary": "Check invoice status (POST)",
        "operationId": "check_invoice_status_api_v1_invoices_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckInvoiceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckInvoiceResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {

                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckInvoiceRequest": {
        "properties": {
          "invoice_id": {
            "type": "string",
            "minLength": 1,
            "title": "Invoice Id"
          }
        },
        "type": "object",
        "required": [
          "invoice_id"
        ],
        "title": "CheckInvoiceRequest"
      },
      "CheckInvoiceResponse": {
        "properties": {
          "invoice_id": {
            "type": "string",
            "title": "Invoice Id"
          },
          "order_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          },
          "request_amount": {
            "type": "integer",
            "title": "Request Amount"
          },
          "final_amount": {
            "type": "integer",
            "title": "Final Amount"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "paid": {
            "type": "boolean",
            "title": "Paid"
          }
        },
        "type": "object",
        "required": [
          "invoice_id",
          "order_id",
          "request_amount",
          "final_amount",
          "status",
          "paid"
        ],
        "title": "CheckInvoiceResponse"
      },
      "CreateInvoiceRequest": {
        "properties": {
          "amount": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "title": "Amount",
            "description": "Invoice amount in Toman",
            "examples": [50000]
          },
          "order_id": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Order Id",
            "description": "Unique order ID per merchant",
            "examples": [
              "12345"
            ]
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url",
            "description": "Optional HTTPS address on your website. When the invoice is approved, rejected, or expired, TonPays sends a JSON POST to this URL with invoice_id, order_id, status, and paid.",
            "examples": [
              "https://myshop.com/tonpays/notify"
            ]
          }
        },
        "type": "object",
        "required": [
          "amount",
          "order_id"
        ],
        "title": "CreateInvoiceRequest",
        "example": {
          "amount": 50000,
          "callback_url": "https://myshop.com/tonpays/notify",
          "order_id": "12345"
        }
      },
      "CreateInvoiceResponse": {
        "properties": {
          "invoice_id": {
            "type": "string",
            "title": "Invoice Id"
          },
          "order_id": {
            "type": "string",
            "title": "Order Id"
          },
          "request_amount": {
            "type": "integer",
            "title": "Request Amount"
          },
          "final_amount": {
            "type": "integer",
            "title": "Final Amount"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "invoice_url": {
            "type": "string",
            "title": "Invoice Url"
          },
          "payment_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Url",
            "description": "Standalone web checkout URL when enabled for this merchant; otherwise omitted"
          },
          "callback_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Callback Url"
          },
          "card_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Card Number",
            "description": "Bank card number (only when enabled for this API key)"
          },
          "card_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Card Name",
            "description": "Bank card holder name (only when enabled for this API key)"
          }
        },
        "type": "object",
        "required": [
          "invoice_id",
          "order_id",
          "request_amount",
          "final_amount",
          "status",
          "invoice_url"
        ],
        "title": "CreateInvoiceResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "description": "Merchant API key from the bot menu: مستندات API",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}